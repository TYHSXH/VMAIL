<mujoco model="planetary_gear_point_acceleration">
  <!-- VMAIL-BUAA | BUAA 5系 理论力学课程组 | 例7-5 外啮合行星齿轮 M 点加速度 -->
  <compiler angle="radian"/>
  <!-- 纯运动学验证工况：重力关闭，齿轮仅作视觉与几何基准，不通过接触传力 -->
  <option timestep="0.001" gravity="0 0 0"/>

  <asset>
    <texture name="buaa_logo" type="2d" file="assets/logo-gray.png"/>
    <material name="buaa_floor" texture="buaa_logo" texuniform="false"
              texrepeat="1 1" rgba="1 1 1 1" specular="0" reflectance="0"/>
  </asset>

  <visual>
    <global offwidth="1280" offheight="960"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.7 0.7 0.7"/>
  </visual>

  <worldbody>
    <light pos="0 -3 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="buaa_floor" pos="0 0 -0.6"/>

    <!-- 定齿轮Ⅰ：固定在基座上，不转动，仅作几何基准 -->
    <body name="gear1" pos="0 0 0">
      <geom name="gear1_geom" type="cylinder" size="0.6 0.05" rgba="0.55 0.6 0.7 0.45"
            contype="0" conaffinity="0" mass="0"/>
      <site name="gear1_center" pos="0 0 0" size="0.01" rgba="0.2 0.2 0.9 1"/>
    </body>

    <!-- 杆 OA：绕 O 点转动，臂长 L = r1 + r2 -->
    <body name="crank" pos="0 0 0">
      <joint name="crank_hinge" type="hinge" axis="0 0 1" pos="0 0 0"
             damping="0" armature="0.02"/>
      <geom name="crank_geom" type="capsule" fromto="0 0 0 0 1.0 0" size="0.02"
            rgba="0.85 0.55 0.15 1" contype="0" conaffinity="0"/>
      <site name="point_o" pos="0 0 0" size="0.012" rgba="0.1 0.1 0.9 1"/>

      <!-- 动齿轮Ⅱ：圆心在 A，绕自身轴转动 -->
      <body name="gear2" pos="0 1.0 0">
        <joint name="gear_hinge" type="hinge" axis="0 0 1" pos="0 0 0"
               damping="0" armature="0.02"/>
        <geom name="gear2_geom" type="cylinder" size="0.4 0.05" rgba="0.95 0.35 0.2 0.45"
              contype="0" conaffinity="0" mass="1"/>
        <site name="point_a" pos="0 0 0" size="0.012" rgba="0.1 0.6 0.1 1"/>
        <site name="point_m" pos="0 0.4 0" size="0.016" rgba="0.95 0.75 0.1 1"/>
        <!-- 啮合点 P：位于 A 指向 O 的一侧，距 A 为 r2；固定在齿轮Ⅱ上 -->
        <site name="point_p" pos="0 -0.4 0" size="0.014" rgba="0.9 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- 内部运动驱动：按 ωOA = ω0 + α0 t 规定杆的角速度 -->
    <velocity name="crank_speed" joint="crank_hinge" kv="15" ctrlrange="-30 30"/>
    <!-- 内部运动驱动：按 ωII = k (ω0 + α0 t) 保证外啮合点无滑移 -->
    <velocity name="gear_speed" joint="gear_hinge" kv="15" ctrlrange="-120 120"/>
  </actuator>
</mujoco>
